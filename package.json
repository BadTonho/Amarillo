{
  "name": "amarillo-argon-bridge",
  "version": "0.1.0",
  "description": "Windows-first Roblox Studio Amarillo plugin + local daemon inspired by Argon.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node src/daemon/index.js",
    "start:workspace": "node src/daemon/index.js --workspace .",
    "package:vsix": "powershell -ExecutionPolicy Bypass -File scripts/package-vsix.ps1",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
